<Window x:Class="gtt_sidebar.Core.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="350"
        Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White"
        BorderThickness="1"
        BorderBrush="#D0D0D0"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <!-- Header -->
            <RowDefinition Height="*" />
            <!-- Content -->
            <RowDefinition Height="50" />
            <!-- Buttons -->
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border Grid.Row="0"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown"
                Cursor="SizeAll">
            <Grid Margin="12,0">
                <TextBlock Text="设置"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseButton"
                        Content="×"
                        Width="24"
                        Height="24"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#666666"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"
                        Cursor="Hand" />
            </Grid>
        </Border>
        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="20,20,20,10">
            <StackPanel>
                <!-- Window & Layout Section -->
                <Border Background="#F8F8F8"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="3"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Collapsible Header -->
                        <Border Background="#EEEEEE"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1"
                                Cursor="Hand"
                                MouseLeftButtonDown="WindowLayoutHeader_Click">
                            <Border Padding="12,8">
                                <Grid>
                                    <TextBlock Text="窗口与布局"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#333333" />
                                    <TextBlock x:Name="WindowLayoutArrow"
                                               Text="▼"
                                               FontSize="10"
                                               Foreground="#666666"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </Border>
                        <!-- Content (collapsible) -->
                        <StackPanel x:Name="WindowLayoutContent"
                                    Margin="16">
                            <!-- Position -->
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="停靠位置"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#666666"
                                           Margin="0,0,0,8" />
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal">
                                    <RadioButton x:Name="RightPositionRadio"
                                                 Content="靠右"
                                                 GroupName="Position"
                                                 FontSize="10"
                                                 Margin="0,0,20,0"
                                                 IsChecked="True" />
                                    <RadioButton x:Name="LeftPositionRadio"
                                                 Content="靠左"
                                                 GroupName="Position"
                                                 FontSize="10" />
                                </StackPanel>
                            </Grid>
                            <!-- Width -->
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,8">
                                    <TextBlock Text="宽度"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="WidthValueText"
                                               Text="122 px"
                                               FontSize="10"
                                               Foreground="#999999"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="WidthSlider"
                                        Grid.Row="1"
                                        Minimum="100"
                                        Maximum="200"
                                        Value="122"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="WidthSlider_ValueChanged" />
                            </Grid>
                            <!-- Margin Top -->
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,8">
                                    <TextBlock Text="上边距"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="MarginTopValueText"
                                               Text="5 px"
                                               FontSize="10"
                                               Foreground="#999999"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="MarginTopSlider"
                                        Grid.Row="1"
                                        Minimum="0"
                                        Maximum="50"
                                        Value="5"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="MarginTopSlider_ValueChanged" />
                            </Grid>
                            <!-- Margin Bottom -->
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,8">
                                    <TextBlock Text="下边距"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="MarginBottomValueText"
                                               Text="5 px"
                                               FontSize="10"
                                               Foreground="#999999"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="MarginBottomSlider"
                                        Grid.Row="1"
                                        Minimum="0"
                                        Maximum="50"
                                        Value="5"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="MarginBottomSlider_ValueChanged" />
                            </Grid>
                            <!-- Margin Side -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,8">
                                    <TextBlock Text="侧边距"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="MarginSideValueText"
                                               Text="5 px"
                                               FontSize="10"
                                               Foreground="#999999"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="MarginSideSlider"
                                        Grid.Row="1"
                                        Minimum="0"
                                        Maximum="50"
                                        Value="5"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="MarginSideSlider_ValueChanged" />
                            </Grid>
                            <!-- 失去焦点自动隐藏 -->
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <!-- 0: 勾选框 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 1: 延迟标签 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 2: 延迟滑块 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 3: 顶部留白标签 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 4: 顶部留白滑块 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 5: 底部留白标签 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 6: 底部留白滑块 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 7: 提示文字 -->
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="AutoHideCheckBox"
                                          Grid.Row="0"
                                          Content="失去焦点后自动贴边隐藏"
                                          FontSize="10"
                                          Foreground="#333333"
                                          Margin="0,0,0,10"
                                          Checked="AutoHideCheckBox_Changed"
                                          Unchecked="AutoHideCheckBox_Changed" />
                                <Grid Grid.Row="1"
                                      Margin="0,0,0,8">
                                    <TextBlock Text="隐藏延迟"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="AutoHideDelayValueText"
                                               Text="600 ms"
                                               FontSize="10"
                                               Foreground="#999999"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="AutoHideDelaySlider"
                                        Grid.Row="2"
                                        Minimum="0"
                                        Maximum="2000"
                                        Value="600"
                                        TickFrequency="100"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="AutoHideDelaySlider_ValueChanged" />

                                <!-- 触发范围顶部留白 -->
                                <Grid Grid.Row="3"
                                      Margin="0,12,0,8">
                                    <TextBlock Text="触发区顶部留白"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="AutoHideEdgeTopValueText"
                                               Text="25%"
                                               FontSize="10"
                                               Foreground="#999999"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="AutoHideEdgeTopSlider"
                                        Grid.Row="4"
                                        Minimum="0"
                                        Maximum="50"
                                        Value="25"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="AutoHideEdgeTopSlider_ValueChanged" />

                                <!-- 触发范围底部留白 -->
                                <Grid Grid.Row="5"
                                      Margin="0,12,0,8">
                                    <TextBlock Text="触发区底部留白"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="AutoHideEdgeBottomValueText"
                                               Text="15%"
                                               FontSize="10"
                                               Foreground="#999999"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="AutoHideEdgeBottomSlider"
                                        Grid.Row="6"
                                        Minimum="0"
                                        Maximum="50"
                                        Value="15"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="AutoHideEdgeBottomSlider_ValueChanged" />

                                <TextBlock Grid.Row="7"
                                           Text="顶部留白可避免遮挡窗口右上角的关闭按钮"
                                           FontSize="9"
                                           Foreground="#999999"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Add this section to your SettingsWindow.xaml BEFORE the Shortcuts section -->
                <!-- System Monitor Settings Section -->
                <Border Grid.Row="4"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Background="White"
                        CornerRadius="3"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Header -->
                        <Grid Grid.Row="0"
                              Background="#F8F8F8"
                              Height="35"
                              Cursor="Hand"
                              MouseLeftButtonDown="SystemMonitorHeader_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="系统监控（显示于系统信息卡片）"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Foreground="#333333" />
                            <TextBlock x:Name="SystemMonitorToggle"
                                       Grid.Column="1"
                                       Text="▼"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="#666666" />
                        </Grid>
                        <!-- Content -->
                        <StackPanel x:Name="SystemMonitorContent"
                                    Grid.Row="1"
                                    Margin="15"
                                    Visibility="Visible">
                            <!-- CPU Threshold -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="CPU 告警："
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="#333333" />
                                <Slider x:Name="CpuThresholdSlider"
                                        Grid.Column="1"
                                        Minimum="50"
                                        Maximum="95"
                                        Value="85"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Margin="10,0,10,0"
                                        ValueChanged="CpuThresholdSlider_ValueChanged" />
                                <TextBlock x:Name="CpuThresholdValue"
                                           Grid.Column="2"
                                           Text="85%"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#333333" />
                            </Grid>
                            <!-- RAM Threshold -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="内存告警："
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="#333333" />
                                <Slider x:Name="RamThresholdSlider"
                                        Grid.Column="1"
                                        Minimum="50"
                                        Maximum="95"
                                        Value="85"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Margin="10,0,10,0"
                                        ValueChanged="RamThresholdSlider_ValueChanged" />
                                <TextBlock x:Name="RamThresholdValue"
                                           Grid.Column="2"
                                           Text="85%"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#333333" />
                            </Grid>
                            <!-- Ping Threshold -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="延迟告警："
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="#333333" />
                                <Slider x:Name="PingThresholdSlider"
                                        Grid.Column="1"
                                        Minimum="25"
                                        Maximum="500"
                                        Value="100"
                                        TickFrequency="25"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Margin="10,0,10,0"
                                        ValueChanged="PingThresholdSlider_ValueChanged" />
                                <TextBlock x:Name="PingThresholdValue"
                                           Grid.Column="2"
                                           Text="100ms"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#333333" />
                            </Grid>
                            <!-- Update Frequency -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="刷新频率："
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="#333333" />
                                <ComboBox x:Name="UpdateFrequencyComboBox"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0"
                                          SelectionChanged="UpdateFrequencyComboBox_SelectionChanged">
                                    <ComboBoxItem Content="1 秒"
                                                  Tag="1" />
                                    <ComboBoxItem Content="2 秒"
                                                  Tag="2"
                                                  IsSelected="True" />
                                    <ComboBoxItem Content="3 秒"
                                                  Tag="3" />
                                    <ComboBoxItem Content="5 秒"
                                                  Tag="5" />
                                    <ComboBoxItem Content="10 秒"
                                                  Tag="10" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Shortcuts Section -->
                <Border Background="#F8F8F8"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="3"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Collapsible Header -->
                        <Border Background="#EEEEEE"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1"
                                Cursor="Hand"
                                MouseLeftButtonDown="ShortcutsHeader_Click">
                            <Border Padding="12,8">
                                <Grid>
                                    <TextBlock Text="快捷方式"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#333333" />
                                    <TextBlock x:Name="ShortcutsArrow"
                                               Text="▼"
                                               FontSize="10"
                                               Foreground="#666666"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </Border>
                        <!-- Content (collapsible) -->
                        <StackPanel x:Name="ShortcutsContent"
                                    Margin="16">
                            <!-- Shortcuts List -->
                            <ScrollViewer x:Name="ShortcutsScrollViewer"
                                          MaxHeight="300"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,0,0,12">
                                <StackPanel x:Name="ShortcutsContainer"
                                            Background="Transparent">
                                    <!-- Individual shortcut cards will be added here dynamically -->
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Add New Shortcut Button -->
                            <Button x:Name="AddShortcutButton"
                                    Content="+ 添加快捷方式"
                                    Height="32"
                                    FontSize="10"
                                    Background="#4A90E2"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Margin="0,0,0,8"
                                    Click="AddShortcutButton_Click" />
                            <!-- Help Text -->
                            <TextBlock Text="修改后点击卡片上的保存按钮生效，或使用上下箭头调整顺序。"
                                       FontSize="9"
                                       Foreground="#999999"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <!-- Buttons -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="ValidationText"
                           Text=""
                           FontSize="9"
                           Foreground="Red"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="20,0">
                    <Button x:Name="CancelButton"
                            Content="取消"
                            Width="80"
                            Height="32"
                            FontSize="10"
                            Background="White"
                            BorderBrush="#C0C0C0"
                            BorderThickness="1"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click" />
                    <Button x:Name="ApplyButton"
                            Content="应用"
                            Width="80"
                            Height="32"
                            FontSize="10"
                            Background="#4A90E2"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ApplyButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>