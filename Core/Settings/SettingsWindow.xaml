<Window x:Class="gtt_sidebar.Core.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="368"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}"
        BorderThickness="1"
        BorderBrush="{StaticResource BorderSubtle}"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 设置分组：白卡片 + 可折叠标题 -->
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 分组标题行 -->
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>

        <!-- 设置项标签（左） -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 设置项数值（右） -->
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 单选按钮：现代药丸样式 -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{StaticResource SurfaceSubtle}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <!-- 标题栏 -->
            <RowDefinition Height="*"/>
            <!-- 内容 -->
            <RowDefinition Height="58"/>
            <!-- 底部按钮 -->
        </Grid.RowDefinitions>

        <!-- ── 标题栏 ── -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCard}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown"
                Cursor="SizeAll">
            <Grid Margin="16,0,10,0">
                <TextBlock Text="设置"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseButton"
                        Style="{StaticResource IconButton}"
                        Width="26" Height="26"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"
                        ToolTip="关闭">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                          Stroke="{StaticResource TextTertiary}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── 内容区 ── -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="14,14,14,4">
            <StackPanel>

                <!-- ============ 窗口与布局 ============ -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderBorder}"
                                MouseLeftButtonDown="WindowLayoutHeader_Click">
                            <Grid>
                                <TextBlock Text="窗口与布局"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="WindowLayoutArrow"
                                           Text="▼"
                                           FontSize="9"
                                           Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderSubtle}"/>

                        <StackPanel x:Name="WindowLayoutContent" Margin="14,13,14,14">

                            <!-- 停靠位置：药丸式单选 -->
                            <TextBlock Text="停靠位置" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="RightPositionRadio"
                                             Grid.Column="0"
                                             Content="贴右边缘"
                                             GroupName="SidebarPosition"
                                             Style="{StaticResource SegmentRadio}"/>
                                <RadioButton x:Name="LeftPositionRadio"
                                             Grid.Column="2"
                                             Content="贴左边缘"
                                             GroupName="SidebarPosition"
                                             Style="{StaticResource SegmentRadio}"/>
                            </Grid>

                            <!-- 宽度 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="宽度" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="WidthValueText" Text="144 px" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Slider x:Name="WidthSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="100" Maximum="200"
                                    TickFrequency="2" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,16"
                                    ValueChanged="WidthSlider_ValueChanged"/>

                            <!-- 上边距 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="上边距" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="MarginTopValueText" Text="5 px" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Slider x:Name="MarginTopSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="50"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,16"
                                    ValueChanged="MarginTopSlider_ValueChanged"/>

                            <!-- 下边距 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="下边距" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="MarginBottomValueText" Text="5 px" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Slider x:Name="MarginBottomSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="50"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,16"
                                    ValueChanged="MarginBottomSlider_ValueChanged"/>

                            <!-- 侧边距 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="侧边距" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="MarginSideValueText" Text="5 px" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Slider x:Name="MarginSideSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="50"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,18"
                                    ValueChanged="MarginSideSlider_ValueChanged"/>

                            <!-- 分隔线 -->
                            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,16"/>

                            <!-- 自动隐藏 -->
                            <CheckBox x:Name="AutoHideCheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="失去焦点后自动隐藏"
                                      Margin="0,0,0,14"
                                      Checked="AutoHideCheckBox_Changed"
                                      Unchecked="AutoHideCheckBox_Changed"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="隐藏延迟" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="AutoHideDelayValueText" Text="600 ms" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Slider x:Name="AutoHideDelaySlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="2000"
                                    TickFrequency="100" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,16"
                                    ValueChanged="AutoHideDelaySlider_ValueChanged"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="触发区顶部留白" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="AutoHideEdgeTopValueText" Text="25%" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Slider x:Name="AutoHideEdgeTopSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="50"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,16"
                                    ValueChanged="AutoHideEdgeTopSlider_ValueChanged"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="触发区底部留白" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="AutoHideEdgeBottomValueText" Text="15%" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Slider x:Name="AutoHideEdgeBottomSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="50"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,6"
                                    ValueChanged="AutoHideEdgeBottomSlider_ValueChanged"/>

                            <TextBlock Text="顶部留白可避免遮挡窗口右上角的关闭按钮"
                                       Style="{StaticResource HintText}"
                                       Margin="0,0,0,16"/>

                            <!-- 收起方式 -->
                            <CheckBox x:Name="FloatingBallCheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="收起为悬浮球"
                                      Margin="0,0,0,7"
                                      Checked="FloatingBallCheckBox_Changed"
                                      Unchecked="FloatingBallCheckBox_Changed"/>
                            <TextBlock Text="收起后在屏幕边缘显示一个小圆球，悬停或点击即可展开；可上下拖动调整位置"
                                       Style="{StaticResource HintText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 系统监控 ============ -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderBorder}"
                                MouseLeftButtonDown="SystemMonitorHeader_Click">
                            <Grid>
                                <TextBlock Text="系统监控"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="SystemMonitorToggle"
                                           Text="▼"
                                           FontSize="9"
                                           Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderSubtle}"/>

                        <StackPanel x:Name="SystemMonitorContent" Margin="14,13,14,14">
                            <TextBlock Text="各项超过阈值时，系统信息卡片中的数值会变色提示"
                                       Style="{StaticResource HintText}"
                                       Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="CPU 告警" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="CpuThresholdValue" Text="85%" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Slider x:Name="CpuThresholdSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="50" Maximum="99"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,14"
                                    ValueChanged="CpuThresholdSlider_ValueChanged"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="内存告警" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="RamThresholdValue" Text="85%" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Slider x:Name="RamThresholdSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="50" Maximum="99"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,14"
                                    ValueChanged="RamThresholdSlider_ValueChanged"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="延迟告警" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="PingThresholdValue" Text="100ms" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Slider x:Name="PingThresholdSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="20" Maximum="500"
                                    TickFrequency="10" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,16"
                                    ValueChanged="PingThresholdSlider_ValueChanged"/>

                            <Grid>
                                <TextBlock Text="刷新频率" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="UpdateFrequencyComboBox"
                                          Width="88"
                                          FontSize="{StaticResource FontSizeBody}"
                                          HorizontalAlignment="Right"
                                          SelectionChanged="UpdateFrequencyComboBox_SelectionChanged">
                                    <ComboBoxItem Content="1 秒" Tag="1"/>
                                    <ComboBoxItem Content="2 秒" Tag="2" IsSelected="True"/>
                                    <ComboBoxItem Content="3 秒" Tag="3"/>
                                    <ComboBoxItem Content="5 秒" Tag="5"/>
                                    <ComboBoxItem Content="10 秒" Tag="10"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 快捷方式 ============ -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderBorder}"
                                MouseLeftButtonDown="ShortcutsHeader_Click">
                            <Grid>
                                <TextBlock Text="快捷方式"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="ShortcutsArrow"
                                           Text="▼"
                                           FontSize="9"
                                           Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderSubtle}"/>

                        <StackPanel x:Name="ShortcutsContent" Margin="14,13,14,14">
                            <!-- 列表不再设 MaxHeight、不再自带滚动条：
                                 卡片数量变多时列表自然变长，由外层 ScrollViewer 统一滚动，
                                 避免"窗口一个滑条 + 列表一个滑条"的双重滚动。 -->
                            <StackPanel x:Name="ShortcutsContainer"
                                        Background="Transparent"
                                        Margin="0,0,0,12">
                                <!-- 快捷方式条目由代码动态生成 -->
                            </StackPanel>

                            <Button x:Name="AddShortcutButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="+  添加快捷方式"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10"
                                    Click="AddShortcutButton_Click"/>

                            <TextBlock Text="修改后点击卡片上的保存按钮生效，或使用上下箭头调整顺序。"
                                       Style="{StaticResource HintText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 组件（插件） ============ -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderBorder}"
                                MouseLeftButtonDown="WidgetsHeader_Click">
                            <Grid>
                                <TextBlock Text="组件"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="WidgetsArrow"
                                           Text="▼"
                                           FontSize="9"
                                           Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderSubtle}"/>

                        <StackPanel x:Name="WidgetsContent" Margin="14,13,14,14">
                            <TextBlock Text="勾选要显示的组件，用箭头调整上下顺序。更改后立即生效。"
                                       Style="{StaticResource HintText}"
                                       Margin="0,0,0,11"/>

                            <!-- 组件列表由代码动态生成 -->
                            <StackPanel x:Name="WidgetsList"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 底部按钮 ── -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceCard}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="ValidationText"
                           Text=""
                           FontSize="9.5"
                           Foreground="{StaticResource StateDanger}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180"
                           Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="取消"
                            MinWidth="72"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ApplyButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="应用"
                            MinWidth="72"
                            Click="ApplyButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
