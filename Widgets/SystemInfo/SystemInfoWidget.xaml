<UserControl x:Class="gtt_sidebar.Widgets.SystemInfo.SystemInfoWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Margin="0,0,0,5">
    <Border Padding="6"
            CornerRadius="3"
            Background="#F8F8F8"
            BorderBrush="#E0E0E0"
            BorderThickness="1">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,5">
                <TextBlock Text="系统信息"
                           Foreground="#333333"
                           FontSize="10"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="UpdateTimeText"
                           Text=""
                           Foreground="#999999"
                           FontSize="7"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 实时负载：CPU / 内存 / 延迟（数值超阈值时标红） -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="CPU"
                           Foreground="#666666"
                           FontSize="8"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="CpuValue"
                           Text="--"
                           Foreground="#333333"
                           FontSize="8"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           ToolTip="CPU 占用率"/>
            </Grid>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="内存"
                           Foreground="#666666"
                           FontSize="8"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="RamValue"
                           Text="--"
                           Foreground="#333333"
                           FontSize="8"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           ToolTip="内存占用率"/>
            </Grid>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="延迟"
                           Foreground="#666666"
                           FontSize="8"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="PingValue"
                           Text="--"
                           Foreground="#333333"
                           FontSize="8"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           ToolTip="网络延迟"/>
            </Grid>

            <!-- 分隔线 -->
            <Border BorderBrush="#E8E8E8"
                    BorderThickness="0,1,0,0"
                    Margin="0,1,0,5"/>

            <!-- 本机信息：运行时长 / 磁盘 / 网络 / 进程数 -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="运行时长"
                           Foreground="#666666"
                           FontSize="8"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="UptimeValue"
                           Text="--"
                           Foreground="#333333"
                           FontSize="8"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="磁盘可用"
                           Foreground="#666666"
                           FontSize="8"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="DiskValue"
                           Text="--"
                           Foreground="#333333"
                           FontSize="8"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="网络"
                           Foreground="#666666"
                           FontSize="8"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="NetworkValue"
                           Text="--"
                           Foreground="#333333"
                           FontSize="8"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Grid Margin="0,0,0,0">
                <TextBlock Text="进程数"
                           Foreground="#666666"
                           FontSize="8"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="ProcessValue"
                           Text="--"
                           Foreground="#333333"
                           FontSize="8"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
