<UserControl x:Class="gtt_sidebar.Widgets.SystemInfo.SystemInfoWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">
    <Border Style="{StaticResource CardBorder}" Padding="11,9">
        <StackPanel>
            <!-- 标题行 -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="系统信息"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="UpdateTimeText"
                           Text=""
                           Foreground="{StaticResource TextTertiary}"
                           FontSize="7.5"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 实时负载：三行纵向排列，标签左、数值右。
                 144px 宽下三列并排时每列仅约 40px，延迟值（如 "249ms"）
                 会被截断成 "249..."，故改为纵向。 -->
            <StackPanel Margin="0,0,0,7">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="CPU"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="8.5"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="CpuValue"
                               Text="--"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               ToolTip="CPU 占用率"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="内存"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="8.5"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="RamValue"
                               Text="--"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               ToolTip="内存占用率"/>
                </Grid>

                <Grid>
                    <TextBlock Text="延迟"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="8.5"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="PingValue"
                               Text="--"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               ToolTip="网络延迟"/>
                </Grid>
            </StackPanel>

            <!-- 分隔线 -->
            <Border Height="1"
                    Background="{StaticResource BorderSubtle}"
                    Margin="0,0,0,7"/>

            <!-- 本机信息：单列全宽，标签左、数值右。
                 之前用两列网格，144px 宽下每列只有约 55px，
                 "123 / 456 GB" 这类文本会被 TextTrimming 截断。 -->
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="运行时长"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="8.5"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="UptimeValue"
                               Text="--"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="磁盘可用"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="8.5"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="DiskValue"
                               Text="--"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="网络"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="8.5"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="NetworkValue"
                               Text="--"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <TextBlock Text="进程数"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="8.5"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ProcessValue"
                               Text="--"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
