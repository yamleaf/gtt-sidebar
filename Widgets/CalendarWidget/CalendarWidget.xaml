<UserControl x:Class="gtt_sidebar.Widgets.CalendarWidget.CalendarWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">
    <Border Style="{StaticResource CardBorder}" Padding="10,11">
        <StackPanel>
            <!-- 月份标题 + 今天标记：用 Grid 分列，避免标题被徽章压住 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonthTitleText"
                           Grid.Column="0"
                           Text="2026年1月"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,6,0"/>
                <Border Grid.Column="1"
                        Background="{StaticResource AccentSoft}"
                        CornerRadius="4"
                        Padding="5,1.5"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TodayTagText"
                               Text="今天"
                               Foreground="{StaticResource AccentPrimary}"
                               FontSize="8"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- 星期表头 -->
            <UniformGrid x:Name="WeekHeaderGrid"
                         Columns="7"
                         Margin="0,0,0,3"/>

            <!-- 日期网格 -->
            <UniformGrid x:Name="DaysGrid"
                         Columns="7"/>

            <!-- 节假日区：浅色底块，与日期网格区分开 -->
            <Border Background="{StaticResource SurfaceSubtle}"
                    CornerRadius="7"
                    Margin="0,9,0,0"
                    Padding="7,6">
                <StackPanel>
                    <TextBlock x:Name="NextHolidayText"
                               Text="--"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="8.5"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountdownText"
                               Text=""
                               Foreground="{StaticResource StateDanger}"
                               FontSize="8.5"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="SourceText"
                               Text=""
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="7.5"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="20"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
