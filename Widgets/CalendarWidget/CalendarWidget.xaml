<UserControl x:Class="gtt_sidebar.Widgets.CalendarWidget.CalendarWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Margin="0,0,0,5">
    <Border Padding="5"
            CornerRadius="3"
            Background="#F8F8F8"
            BorderBrush="#E0E0E0"
            BorderThickness="1">
        <StackPanel>
            <!-- 月份标题 -->
            <Grid Margin="0,0,0,4">
                <TextBlock x:Name="MonthTitleText"
                           Text="2026年1月"
                           Foreground="#333333"
                           FontSize="10"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="TodayTagText"
                           Text="今天"
                           Foreground="#4A90E2"
                           FontSize="8"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 星期表头 -->
            <UniformGrid x:Name="WeekHeaderGrid"
                         Columns="7"
                         Margin="0,0,0,2"/>

            <!-- 日期网格 -->
            <UniformGrid x:Name="DaysGrid"
                         Columns="7"/>

            <!-- 分隔线 -->
            <Border BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    Margin="0,5,0,0"
                    Padding="0,4,0,0">
                <StackPanel>
                    <!-- 下一个节假日 -->
                    <Grid>
                        <TextBlock x:Name="NextHolidayText"
                                   Text="--"
                                   Foreground="#333333"
                                   FontSize="8"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="CountdownText"
                                   Text=""
                                   Foreground="#D9534F"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <!-- 数据来源/状态 -->
                    <TextBlock x:Name="SourceText"
                               Text=""
                               Foreground="#BBBBBB"
                               FontSize="7"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
