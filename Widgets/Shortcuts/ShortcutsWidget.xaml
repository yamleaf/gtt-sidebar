<UserControl x:Class="gtt_sidebar.Widgets.Shortcuts.ShortcutsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">
    <Border Style="{StaticResource CardBorder}" Padding="11,10">
        <StackPanel>
            <!-- 标题行 + 添加按钮 -->
            <Grid Margin="0,0,0,6">
                <TextBlock x:Name="HeaderText"
                           Text="快捷方式"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
                <Button x:Name="AddButton"
                        Style="{StaticResource IconButton}"
                        Width="20" Height="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="添加快捷方式"
                        Click="AddButton_Click">
                    <Path Data="M 5,0 L 5,10 M 0,5 L 10,5"
                          Stroke="{StaticResource TextTertiary}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 快捷方式网格（由代码动态生成）。
                 不使用 ScrollViewer：卡片高度随图标行数自然增长，
                 不出现内部滚动条；过长时由外层侧边栏整体滚动。 -->
            <Grid x:Name="ShortcutsGrid">
                <!-- Dynamic grid will be created in code-behind -->
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
