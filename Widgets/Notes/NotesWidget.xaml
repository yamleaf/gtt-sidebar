<UserControl x:Class="gtt_sidebar.Widgets.Notes.NotesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Height="185"
             Margin="0,0,0,5"
             Cursor="Hand">
    <Border Padding="6" 
            CornerRadius="3"
            Background="#F8F8F8"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Cursor="Hand">
        <Grid Cursor="Hand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,4" Cursor="Hand">
                <TextBlock Text="备注" 
                           Foreground="#333333" 
                           FontSize="10"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           Cursor="Hand"
                           IsHitTestVisible="False"/>
                <TextBlock x:Name="TabCountText"
                           Text="1 个标签" 
                           Foreground="#666666" 
                           FontSize="8"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Preview Content -->
            <Border Grid.Row="1" 
        Background="Transparent"
        Cursor="Hand">
                <TextBlock x:Name="PreviewText"
              Text="点击此处开始记录…"
              Foreground="#666666"
              FontSize="8"
              TextWrapping="Wrap"
              LineHeight="10"
              MaxHeight="140"
              Margin="2"
              Cursor="Hand"
              IsHitTestVisible="False"
              VerticalAlignment="Top"/>
            </Border>
        </Grid>
    </Border>
</UserControl>