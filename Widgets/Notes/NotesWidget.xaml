<UserControl x:Class="gtt_sidebar.Widgets.Notes.NotesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Height="190"
             Cursor="Hand"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">
    <!-- 整张卡可点击打开备注弹窗，所以 Cursor 与命中测试都要保留 -->
    <Border Style="{StaticResource CardBorder}"
            Padding="11,10"
            Cursor="Hand">
        <Grid Cursor="Hand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid Grid.Row="0" Margin="0,0,0,7" Cursor="Hand">
                <TextBlock Text="备注"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           Cursor="Hand"
                           IsHitTestVisible="False"/>
                <Border Background="{StaticResource SurfaceSubtle}"
                        CornerRadius="4"
                        Padding="5,1.5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="TabCountText"
                               Text="1 个标签"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="8"
                               Cursor="Hand"/>
                </Border>
            </Grid>

            <!-- 内容预览 -->
            <Border Grid.Row="1" Background="Transparent" Cursor="Hand">
                <TextBlock x:Name="PreviewText"
                           Text="点击此处开始记录…"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="9"
                           TextWrapping="Wrap"
                           LineHeight="14"
                           MaxHeight="140"
                           Cursor="Hand"
                           IsHitTestVisible="False"
                           VerticalAlignment="Top"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
