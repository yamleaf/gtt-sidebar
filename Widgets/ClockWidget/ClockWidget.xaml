<UserControl x:Class="gtt_sidebar.Widgets.ClockWidget.ClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">
    <Border Style="{StaticResource CardBorder}" Padding="12,13">
        <StackPanel>
            <!-- 时间：Viewbox 等比缩放，窗口变窄也不会被裁切。
                 StretchDirection=DownOnly 保证小字号下不放大，只在大字号溢出时缩小。 -->
            <Viewbox Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Stretch"
                     MaxHeight="32">
                <TextBlock x:Name="TimeDisplay"
                           Text="00:00:00"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="26"
                           FontWeight="Light"
                           TextOptions.TextFormattingMode="Ideal"/>
            </Viewbox>

            <!-- 日期：弱化处理，让时间更突出 -->
            <Viewbox Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Stretch"
                     MaxHeight="13"
                     Margin="0,3,0,0">
                <TextBlock x:Name="DateDisplay"
                           Text="2025年1月1日 星期三"
                           Foreground="{StaticResource TextTertiary}"
                           FontSize="9.5"/>
            </Viewbox>
        </StackPanel>
    </Border>
</UserControl>
