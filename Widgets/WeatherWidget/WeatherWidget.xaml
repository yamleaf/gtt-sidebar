<UserControl x:Class="gtt_sidebar.Widgets.WeatherWidget.WeatherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">
    <Border Style="{StaticResource CardBorder}">
        <StackPanel>

            <!-- 当前天气：图标与温度同一行，比之前的竖直堆叠更紧凑也更现代 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="WeatherIcon"
                           Grid.Column="0"
                           Text="☀️"
                           FontSize="30"
                           VerticalAlignment="Center"
                           Margin="0,0,2,0"/>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="Temperature"
                               Text="22°"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="21"
                               FontWeight="Light"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="WeatherDescription"
                               Text="晴"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="9.5"
                               HorizontalAlignment="Right"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 分隔线：极浅，避免割裂卡片 -->
            <Border Height="1"
                    Background="{StaticResource BorderSubtle}"
                    Margin="0,10,0,8"/>

            <!-- 三日预报：等宽三列，比之前手动 Margin 更整齐 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="Day1Icon" Text="⛅" FontSize="15" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Day1Temp" Text="--°"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="Day2Icon" Text="🌧️" FontSize="15" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Day2Temp" Text="--°"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="Day3Icon" Text="☀️" FontSize="15" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Day3Temp" Text="--°"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 城市：可点击切换，用弱化色 + 悬停变色暗示可交互 -->
            <TextBlock x:Name="LocationText"
                       Text="加载中…"
                       Foreground="{StaticResource TextTertiary}"
                       FontSize="9"
                       HorizontalAlignment="Center"
                       Margin="0,9,0,0"
                       Cursor="Hand"
                       MouseLeftButtonDown="LocationText_MouseLeftButtonDown">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
